# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Model used to write the scoring memo
ANTHROPIC_MODEL=claude-opus-5

# How hard the model works on each memo: low | medium | high | xhigh | max.
# 'high' is the default and the sweet spot; 'low' is much cheaper and noticeably
# shallower; 'max' is for deals you are seriously considering.
ANTHROPIC_EFFORT=high

# Before scoring, search public sources for what the founders' materials leave
# out: funding history, real competitors, founder track record, anything
# embarrassing. Costs a second API call per memo — set to false to score from
# the supplied materials alone.
ENABLE_WEB_RESEARCH=true

# How many searches the research pass may run
MAX_SEARCH_USES=8

# Where uploaded decks/models and deal state are kept
DATA_DIR=./data

# Optional allowlist. Comma-separated Telegram user IDs; empty means anyone can
# use the bot. Recommended, since every memo costs API credits.
ALLOWED_USER_IDS=

# Optional: cap on how much extracted text from any single source is sent to the model
MAX_SOURCE_CHARS=60000
